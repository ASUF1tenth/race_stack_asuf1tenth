<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autodrive_bridge_adapter</name>
  <version>0.0.0</version>
  <description>Translates between the AutoDRIVE RoboRacer bridge topics and the ForzaETH race-stack topic conventions (drive commands, IMU/LiDAR renaming, and encoder+steering derived wheel odometry). Uses only runtime-permitted AutoDRIVE topics.</description>
  <maintainer email="mohammedhany300@gmail.com">Mohammed159159</maintainer>
  <license>Apache License 2.0</license>

  <exec_depend>ros2launch</exec_depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>ackermann_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
